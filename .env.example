# NutriAgent — Environment Variable Configuration
# ------------------------------------------------
# Copy this file to .env and replace the placeholder with your real Groq API key.
#
# How to get a Groq API key:
#   1. Visit https://console.groq.com
#   2. Sign up or log in
#   3. Navigate to API Keys and create a new key
#   4. Copy the key and paste it below
#
# IMPORTANT: Never commit your real .env file to version control.
#            Keep your API key secret.

GROQ_API_KEY=your_groq_api_key_here

# Optional: change the port the Flask server listens on (default: 5000)
# PORT=5000
